{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "grimace: emulator mips-ce1",
            "type": "process",
            "command": "${env:GRIMACE_TOOLCHAIN}/tools/grimace-emulator",
            "args": [
                "--target",
                "mips-ce1"
            ],
            "isBackground": true,
            "problemMatcher": {
                "owner": "grimace",
                "pattern": {
                    "regexp": "^grimace-emulator: error: (.*)$",
                    "message": 1
                },
                "background": {
                    "activelyMatching": true,
                    "beginsPattern": "^grimace-emulator: starting",
                    "endsPattern": "^(debugmgr: ready|gdb: listening on )"
                }
            }
        },
