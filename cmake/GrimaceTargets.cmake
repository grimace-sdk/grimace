# grimace_add_executable() and grimace_add_library(): link an ELF with lld against a linker script in ld/, then
# have tools/mkpe.py convert it to a Windows CE PE after the build. A DLL is linked as an executable too, with
# --undefined keeping each export alive.
include_guard(GLOBAL)

function(_grimace_link target script)
    set_target_properties(${target} PROPERTIES SUFFIX ".elf" LINK_DEPENDS "${script}")
    target_link_options(${target} PRIVATE -T "${script}")
    target_link_libraries(${target} PRIVATE
        grimace::headers grimace::runtime grimace::coredll "$<$<LINK_LANGUAGE:CXX>:${GRIMACE_CXX_LIBRARIES}>"
    )
endfunction()

function(_grimace_pe target output)
    set_property(TARGET ${target} APPEND PROPERTY LINK_DEPENDS "${GRIMACE_TOOLCHAIN_ROOT}/tools/mkpe.py")
    add_custom_command(TARGET ${target} POST_BUILD
        COMMAND "${Python3_EXECUTABLE}" "${GRIMACE_TOOLCHAIN_ROOT}/tools/mkpe.py" "$<TARGET_FILE:${target}>"
                "$<TARGET_FILE_DIR:${target}>/${output}" "--ce-version=${GRIMACE_CE_VERSION}" ${ARGN}
        VERBATIM
    )
endfunction()

# Compile each .rc in RESOURCES with llvm-rc, against the SDK headers and GRIMACE_RC_INCLUDES. The other files
# in RESOURCES are what the scripts refer to, so a change rebuilds them. Return the --resources options for
# tools/mkpe.py.
function(_grimace_resources target out_options)
    set(options "")
    set(dependencies "")
    set(scripts "")
    foreach(resource IN LISTS ARGN)
        get_filename_component(resource "${resource}" ABSOLUTE)
        if(resource MATCHES "\\.rc$")
            list(APPEND scripts "${resource}")
        else()
            list(APPEND dependencies "${resource}")
        endif()
    endforeach()
    if(scripts)
        find_program(GRIMACE_RC llvm-rc HINTS "${GRIMACE_LLVM_ROOT}/bin" REQUIRED)
    endif()
    set(defines -D "_WIN32_WCE=${GRIMACE_WIN32_WCE}")
    foreach(define IN LISTS GRIMACE_ARCH_DEFINES)
        list(APPEND defines -D "${define}")
    endforeach()
    set(includes -I "${GRIMACE_TOOLCHAIN_ROOT}/include" -I "${GRIMACE_TOOLCHAIN_ROOT}/include/w32api")
    set(project_includes "")
    foreach(directory IN LISTS GRIMACE_RC_INCLUDES)
        list(APPEND project_includes -I "${directory}")
    endforeach()
    foreach(script IN LISTS scripts)
        get_filename_component(name "${script}" NAME_WE)
        get_filename_component(directory "${script}" DIRECTORY)
        set(compiled "${CMAKE_CURRENT_BINARY_DIR}/${target}_${name}.res")
        add_custom_command(
            OUTPUT "${compiled}"
            COMMAND "${GRIMACE_RC}" ${defines} ${includes} -I "${directory}" ${project_includes} -FO "${compiled}"
                    -- "${script}"
            DEPENDS "${script}" ${dependencies}
            VERBATIM
        )
        target_sources(${target} PRIVATE "${compiled}")
        set_property(TARGET ${target} APPEND PROPERTY LINK_DEPENDS "${compiled}")
        list(APPEND options "--resources=${compiled}")
    endforeach()
    set(${out_options} ${options} PARENT_SCOPE)
endfunction()

function(_grimace_require_exports target)
    foreach(export IN LISTS ARGN)
        string(REGEX REPLACE "^[^=]*=" "" symbol "${export}")
        target_link_options(${target} PRIVATE "--undefined=${symbol}")
    endforeach()
endfunction()

function(grimace_add_executable target)
    cmake_parse_arguments(PARSE_ARGV 1 EXECUTABLE
        "EXCLUDE_FROM_ALL" "OUTPUT;ICON;TEXT_ADDRESS;STACK_SIZE" "RESOURCES"
    )
    if(NOT EXECUTABLE_OUTPUT)
        set(EXECUTABLE_OUTPUT "${target}.exe")
    endif()
    if(NOT EXECUTABLE_STACK_SIZE)
        set(EXECUTABLE_STACK_SIZE "${GRIMACE_DEFAULT_STACK_SIZE}")
    endif()
    set(exclude "")
    if(EXECUTABLE_EXCLUDE_FROM_ALL)
        set(exclude EXCLUDE_FROM_ALL)
    endif()
    add_executable(${target} ${exclude} ${EXECUTABLE_UNPARSED_ARGUMENTS})
    _grimace_link(${target} "${GRIMACE_TOOLCHAIN_ROOT}/ld/exe.ld")
    if(EXECUTABLE_TEXT_ADDRESS)
        target_link_options(${target} PRIVATE "--defsym=GRIMACE_TEXT_ADDRESS=${EXECUTABLE_TEXT_ADDRESS}")
    endif()
    set(options "")
    if(EXECUTABLE_ICON)
        get_filename_component(icon "${EXECUTABLE_ICON}" ABSOLUTE)
        list(APPEND options "--icon=${icon}")
    endif()
    if(EXECUTABLE_STACK_SIZE)
        list(APPEND options "--stack-size=${EXECUTABLE_STACK_SIZE}")
    endif()
    _grimace_resources(${target} resource_options ${EXECUTABLE_RESOURCES})
    _grimace_pe(${target} "${EXECUTABLE_OUTPUT}" ${options} ${resource_options})
    _grimace_add_gdb_script(${target} "${EXECUTABLE_OUTPUT}" GRIMACE_EXECUTABLES)
endfunction()

function(grimace_add_library target)
    cmake_parse_arguments(PARSE_ARGV 1 LIBRARY "EXCLUDE_FROM_ALL" "OUTPUT;EXPORTS_FILE" "EXPORTS;RESOURCES")
    if(NOT LIBRARY_OUTPUT)
        set(LIBRARY_OUTPUT "${target}.dll")
    endif()
    if(NOT LIBRARY_EXPORTS AND NOT LIBRARY_EXPORTS_FILE)
        message(FATAL_ERROR "grimace_add_library(${target}) needs EXPORTS or EXPORTS_FILE")
    endif()
    set(exclude "")
    if(LIBRARY_EXCLUDE_FROM_ALL)
        set(exclude EXCLUDE_FROM_ALL)
    endif()
    add_executable(${target} ${exclude} ${LIBRARY_UNPARSED_ARGUMENTS})
    _grimace_link(${target} "${GRIMACE_TOOLCHAIN_ROOT}/ld/dll.ld")
    set(options "")
    _grimace_require_exports(${target} ${LIBRARY_EXPORTS})
    if(LIBRARY_EXPORTS)
        string(JOIN "," exports ${LIBRARY_EXPORTS})
        list(APPEND options "--exports=${exports}")
    endif()
    if(LIBRARY_EXPORTS_FILE)
        get_filename_component(exports_file "${LIBRARY_EXPORTS_FILE}" ABSOLUTE)
        file(STRINGS "${exports_file}" file_exports)
        _grimace_require_exports(${target} ${file_exports})
        list(APPEND options "--exports-file=${exports_file}")
        set_property(TARGET ${target} APPEND PROPERTY LINK_DEPENDS "${exports_file}")
    endif()
    _grimace_resources(${target} resource_options ${LIBRARY_RESOURCES})
    _grimace_pe(${target} "${LIBRARY_OUTPUT}" ${options} ${resource_options})
    set_target_properties(${target} PROPERTIES GRIMACE_OUTPUT "${LIBRARY_OUTPUT}")
    if(NOT LIBRARY_EXCLUDE_FROM_ALL)
        _grimace_add_gdb_script(${target} "${LIBRARY_OUTPUT}" GRIMACE_LIBRARIES)
    endif()
endfunction()
