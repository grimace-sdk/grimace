# grimace_package(): describe a package as JSON for tools/mkpackage.py, built by the packages target. The paths
# are generator expressions, so file(GENERATE) writes the description.
include_guard(GLOBAL)

# Set a string member. string(JSON) takes a JSON value, so quote and escape it here.
function(_grimace_json_set json_variable member text)
    string(REPLACE "\\" "\\\\" text "${text}")
    string(REPLACE "\"" "\\\"" text "${text}")
    string(JSON json SET "${${json_variable}}" "${member}" "\"${text}\"")
    set(${json_variable} "${json}" PARENT_SCOPE)
endfunction()

# Append a JSON value to an array.
function(_grimace_json_append json_variable value)
    string(JSON count LENGTH "${${json_variable}}")
    string(JSON json SET "${${json_variable}}" ${count} "${value}")
    set(${json_variable} "${json}" PARENT_SCOPE)
endfunction()

function(grimace_package name)
    cmake_parse_arguments(PARSE_ARGV 1 PACKAGE "" "PROVIDER;DIRECTORY" "TARGETS;FILES;SHORTCUTS;FORMATS")
    if(NOT PACKAGE_DIRECTORY)
        set(PACKAGE_DIRECTORY "%CE1%\\${name}")
    endif()
    if(NOT PACKAGE_FORMATS)
        set(PACKAGE_FORMATS cab zip exe)
    endif()
    string(REPLACE "." "" version "${GRIMACE_CE_VERSION}")
    set(label "${GRIMACE_ARCH}-ce${version}")
    if(GRIMACE_PLATFORM)
        string(APPEND label "-${GRIMACE_PLATFORM}")
    endif()
    if(GRIMACE_DEVICE)
        string(APPEND label "-${GRIMACE_DEVICE}")
    endif()

    set(description "{}")
    _grimace_json_set(description name "${name}")
    _grimace_json_set(description provider "${PACKAGE_PROVIDER}")
    _grimace_json_set(description arch "${GRIMACE_ARCH}")
    _grimace_json_set(description label "${label}")
    _grimace_json_set(description directory "${PACKAGE_DIRECTORY}")
    _grimace_json_set(description output "${CMAKE_BINARY_DIR}/packages")

    set(files "[]")
    foreach(target IN LISTS PACKAGE_TARGETS)
        get_target_property(output ${target} GRIMACE_OUTPUT)
        set(file "{}")
        _grimace_json_set(file path "$<TARGET_FILE_DIR:${target}>/${output}")
        _grimace_json_set(file name "${output}")
        _grimace_json_append(files "${file}")
    endforeach()
    foreach(path IN LISTS PACKAGE_FILES)
        get_filename_component(path "${path}" ABSOLUTE)
        get_filename_component(file_name "${path}" NAME)
        set(file "{}")
        _grimace_json_set(file path "${path}")
        _grimace_json_set(file name "${file_name}")
        _grimace_json_append(files "${file}")
    endforeach()
    string(JSON description SET "${description}" files "${files}")

    set(shortcuts "[]")
    set(remaining ${PACKAGE_SHORTCUTS})
    while(remaining)
        list(POP_FRONT remaining target shortcut_name)
        get_target_property(output ${target} GRIMACE_OUTPUT)
        set(shortcut "{}")
        _grimace_json_set(shortcut file "${output}")
        _grimace_json_set(shortcut name "${shortcut_name}")
        _grimace_json_append(shortcuts "${shortcut}")
    endwhile()
    string(JSON description SET "${description}" shortcuts "${shortcuts}")

    set(formats "[]")
    foreach(format IN LISTS PACKAGE_FORMATS)
        _grimace_json_append(formats "\"${format}\"")
    endforeach()
    string(JSON description SET "${description}" formats "${formats}")

    set(installer_target "")
    if("exe" IN_LIST PACKAGE_FORMATS)
        if(NOT TARGET grimace_installer)
            grimace_add_executable(grimace_installer EXCLUDE_FROM_ALL OUTPUT ceinstall.exe
                "${GRIMACE_TOOLCHAIN_ROOT}/installer/ceinstall.c"
            )
        endif()
        _grimace_json_set(description installer "$<TARGET_FILE_DIR:grimace_installer>/ceinstall.exe")
        set(installer_target grimace_installer)
    endif()

    set(description_file "${CMAKE_CURRENT_BINARY_DIR}/${name}-package.json")
    file(GENERATE OUTPUT "${description_file}" CONTENT "${description}")
    string(MAKE_C_IDENTIFIER "${name}" identifier)
    add_custom_target(grimace_package_${identifier}
        COMMAND "${Python3_EXECUTABLE}" "${GRIMACE_TOOLCHAIN_ROOT}/tools/mkpackage.py" "${description_file}"
        DEPENDS ${PACKAGE_TARGETS} ${installer_target} "${GRIMACE_TOOLCHAIN_ROOT}/tools/mkpackage.py"
                "${GRIMACE_TOOLCHAIN_ROOT}/tools/cab.py" "${GRIMACE_TOOLCHAIN_ROOT}/tools/selfinstall.py"
        VERBATIM
    )
    if(NOT TARGET packages)
        add_custom_target(packages)
    endif()
    add_dependencies(packages grimace_package_${identifier})
endfunction()
